{
  "id": "frps-darwin-arm64",
  "name": "frps",
  "display_name": "FRP Server (darwin/arm64)",
  "description": "FRP server executable.",
  "version": "0.68.1",
  "side": "server",
  "platforms": ["mac"],
  "arch": "arm64",
  "category": "network",
  "tags": ["frp", "frps", "proxy", "tunnel"],
  "package": {
    "filename": "frps_0.68.1_darwin_arm64.zip",
    "download_url": "/api/external-tools/packages/frps_0.68.1_darwin_arm64.zip",
    "executable_rel_path": "frps_0.68.1_darwin_arm64/frps"
  },
  "install": {
    "install_dir": "{{external_tools_root}}/{{id}}/{{version}}",
    "skip_if_exists": "{{install_dir}}/frps_0.68.1_darwin_arm64/frps"
  },
  "params": [
    {
      "name": "instance_name",
      "label": "Instance Name",
      "type": "string",
      "required": true,
      "default": "frps-7000",
      "description": "Unique name for this frps instance. It controls config/log/pid isolation."
    },
    {
      "name": "bind_port",
      "label": "FRPS Control Port",
      "type": "integer",
      "required": true,
      "default": 7000,
      "min": 1,
      "max": 65535,
      "description": "frps bind port. frpc connects to this port as server_port."
    }
  ],
  "config": {
    "target": "{{instance_runtime_dir}}/frps.toml",
    "template": "bindPort = {{bind_port}}\n"
  },
  "runtime": {
    "cwd": "{{install_dir}}/frps_0.68.1_darwin_arm64",
    "argv": [
      "{{install_dir}}/frps_0.68.1_darwin_arm64/frps",
      "-c",
      "{{instance_runtime_dir}}/frps.toml"
    ],
    "stdout": "{{instance_runtime_dir}}/stdout.log",
    "stderr": "stdout",
    "pid_file": "{{instance_runtime_dir}}/tool.pid",
    "state_file": "{{instance_runtime_dir}}/state.json"
  },
  "lifecycle": {
    "stop": {
      "type": "signal",
      "signal": "TERM",
      "timeout_sec": 5,
      "kill_after_timeout": true
    },
    "status": {
      "type": "pid_file"
    }
  }
}

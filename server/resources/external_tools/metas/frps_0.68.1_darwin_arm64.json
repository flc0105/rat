{
  "id": "frps-darwin-arm64",
  "name": "frps",
  "display_name": "FRP Server (darwin/arm64)",
  "description": "FRP server executable.",
  "version": "0.68.1",
  "side": "server",
  "platforms": ["mac"],
  "arch": "arm64",
  "category": "network",
  "tags": ["frp", "frps", "proxy", "tunnel"],
  "package": {
    "filename": "frps_0.68.1_darwin_arm64.zip",
    "download_url": "/api/external-tools/packages/frps_0.68.1_darwin_arm64.zip",
    "executable_rel_path": "frps_0.68.1_darwin_arm64/frps"
  },
  "install": {
    "install_dir": "{{external_tools_root}}/{{id}}/{{version}}",
    "skip_if_exists": "{{install_dir}}/frp_0.61.1_linux_amd64/frps"
  },
  "params": [
    {
      "name": "bind_port",
      "type": "integer",
      "required": true,
      "default": 7000,
      "min": 1,
      "max": 65535,
      "description": "frps bind port"
    }
  ],
  "config": {
    "target": "{{install_dir}}/frps_0.68.1_darwin_arm64/frps.toml",
    "template": "bindPort = {{bind_port}}\n"
  },
  "runtime": {
    "cwd": "{{install_dir}}/frps_0.68.1_darwin_arm64",
    "argv": [
      "{{install_dir}}/frps_0.68.1_darwin_arm64/frps",
      "-c",
      "{{install_dir}}/frps_0.68.1_darwin_arm64/frps.toml"
    ],
    "stdout": "{{external_tools_runtime}}/{{id}}/stdout.log",
    "stderr": "stdout",
    "pid_file": "{{external_tools_runtime}}/{{id}}/tool.pid"
  }
}

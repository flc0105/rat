{
  "id": "mediamtx-server-darwin-arm64",
  "name": "mediamtx",
  "display_name": "MediaMTX Server (darwin/arm64)",
  "description": "Realtime media gateway for receiving FFmpeg streams and exposing WebRTC/HLS pages in browser. http://127.0.0.1:8889/screen-macbook/",
  "version": "1.18.0",
  "side": "server",
  "platforms": ["mac"],
  "arch": "arm64",
  "category": "media",
  "tags": ["mediamtx", "rtsp", "rtmp", "webrtc", "hls", "screen-live"],
  "package": {
    "filename": "mediamtx_v1.18.0_darwin_arm64.zip",
    "download_url": "/api/external-tools/packages/mediamtx_v1.18.0_darwin_arm64.zip",
    "executable_rel_path": "mediamtx_v1.18.0_darwin_arm64/mediamtx"
  },
  "install": {
    "install_dir": "{{external_tools_root}}/{{id}}/{{version}}",
    "skip_if_exists": "{{install_dir}}/mediamtx_v1.18.0_darwin_arm64/mediamtx"
  },
  "params": [
    {
      "name": "instance_name",
      "label": "Instance Name",
      "type": "string",
      "required": true,
      "default": "mediamtx-main",
      "description": "Unique name for this MediaMTX server instance."
    },
    {
      "name": "rtsp_port",
      "label": "RTSP Publish Port",
      "type": "integer",
      "required": true,
      "default": 8554,
      "min": 1,
      "max": 65535,
      "description": "RTSP port used by FFmpeg to publish streams."
    },
    {
      "name": "rtmp_port",
      "label": "RTMP Publish Port",
      "type": "integer",
      "required": true,
      "default": 1935,
      "min": 1,
      "max": 65535,
      "description": "Optional RTMP publish port."
    },
    {
      "name": "hls_port",
      "label": "HLS Web Port",
      "type": "integer",
      "required": true,
      "default": 8888,
      "min": 1,
      "max": 65535,
      "description": "HLS browser playback port."
    },
    {
      "name": "webrtc_port",
      "label": "WebRTC Web Port",
      "type": "integer",
      "required": true,
      "default": 8889,
      "min": 1,
      "max": 65535,
      "description": "WebRTC browser playback port. Open http://server_ip:webrtc_port/stream_name/."
    }
  ],
  "config": {
    "target": "{{instance_runtime_dir}}/mediamtx.yml",
    "template": "rtsp: yes\nrtspAddress: :{{rtsp_port}}\n\nrtmp: yes\nrtmpAddress: :{{rtmp_port}}\n\nhls: yes\nhlsAddress: :{{hls_port}}\n\nwebrtc: yes\nwebrtcAddress: :{{webrtc_port}}\n\npaths:\n  all:\n"
  },
  "runtime": {
    "cwd": "{{install_dir}}/mediamtx_v1.18.0_darwin_arm64",
    "argv": [
      "{{install_dir}}/mediamtx_v1.18.0_darwin_arm64/mediamtx",
      "{{instance_runtime_dir}}/mediamtx.yml"
    ],
    "stdout": "{{instance_runtime_dir}}/stdout.log",
    "stderr": "stdout",
    "pid_file": "{{instance_runtime_dir}}/tool.pid",
    "state_file": "{{instance_runtime_dir}}/state.json"
  },
  "lifecycle": {
    "stop": {
      "type": "signal",
      "signal": "TERM",
      "timeout_sec": 5,
      "kill_after_timeout": true
    },
    "status": {
      "type": "pid_file"
    }
  }
}
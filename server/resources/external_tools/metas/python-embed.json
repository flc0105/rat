{
  "id": "python-embed",
  "name": "python-embed",
  "display_name": "Python Embed",
  "description": "Portable Windows embeddable Python runtime.",
  "version": "3.13.13",
  "category": "runtime",
  "tags": [
    "python",
    "embed",
    "portable",
    "windows"
  ],
  "source": "https://www.python.org/downloads/windows/",
  "platform_packages": {
    "win-amd64": {
      "platform": "win",
      "arch": "amd64",
      "filename": "python-3.13.13-embed-amd64-with-deps.zip",
      "download_url": "/api/external-tools/packages/python-3.13.13-embed-amd64-with-deps.zip",
      "root": ""
    }
  },
  "execs": {
    "python": {
      "paths": {
        "win-amd64": "python.exe"
      }
    }
  },
  "install": {
    "install_dir": "{{external_tools_root}}/{{package_id}}/{{version}}/{{package_key}}"
  },
  "modules": [
    {
      "id": "test",
      "name": "python-embed-test",
      "display_name": "Python Embed Test",
      "description": "Run a short Python code snippet with the embedded Python runtime.",
      "execution": "daemon",
      "exec": "python",
      "params": [
        {
          "name": "instance_name",
          "label": "Instance Name",
          "type": "string",
          "required": true,
          "default": "python-embed-test",
          "description": "Unique name for this Python test instance."
        },
        {
          "name": "code",
          "label": "Python Code",
          "type": "string",
          "required": true,
          "default": "import sys; print(sys.version); print('python-embed ok')",
          "description": "Short Python code snippet passed to python -c."
        }
      ],
      "config": {
        "target": "{{instance_runtime_dir}}/python-embed-test.env",
        "template": "PYTHON={{bin_python}}\nCODE={{code}}\n"
      },
      "runtime": {
        "cwd": "{{install_dir}}/{{package_root}}",
        "argv": [
          "{{bin_python}}",
          "-c",
          "{{code}}"
        ],
        "stdout": "{{instance_runtime_dir}}/stdout.log",
        "stderr": "stdout",
        "pid_file": "{{instance_runtime_dir}}/tool.pid",
        "state_file": "{{instance_runtime_dir}}/state.json"
      },
      "lifecycle": {
        "stop": {
          "type": "signal",
          "signal": "TERM",
          "timeout_sec": 5,
          "kill_after_timeout": true
        },
        "status": {
          "type": "pid_file"
        }
      }
    }
  ]
}